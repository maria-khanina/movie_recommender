# !! run "echo -e "AIRFLOW_UID=$(id -u)" > .env"
# !! necessary key for api-requests to omdb
OMDB_KEY=

# directory with dags, config, plugins
AIRFLOW_PROJ_DIR=

# Airflow ui account username (optional)
_AIRFLOW_WWW_USER_USERNAME=
# Airflow ui account password (optional)
_AIRFLOW_WWW_USER_PASSWORD=

# mongodb user name for connection, optional
DB_USER=
# mongodb user password, optional
DB_PASSWORD=